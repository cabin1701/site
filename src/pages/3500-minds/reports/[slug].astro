---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((r) => ({ params: { slug: r.id }, props: { report: r } }));
}

const { report } = Astro.props;
const { Content } = await render(report);
const base = import.meta.env.BASE_URL;

const allReports = await getCollection('reports');
const sorted = [...allReports].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const recentEntries = sorted
  .filter((r) => r.id !== report.id)
  .slice(0, 5)
  .map((r) => ({ href: `${base}3500-minds/reports/${r.id}/`, date: r.data.date.toISOString().slice(0, 10), title: r.data.title }));

// Categories: parent -> child, max 2 levels
const categoryTree = new Map<string, Map<string, number>>();
for (const r of allReports) {
  const [parent, child] = r.data.category;
  if (!categoryTree.has(parent)) categoryTree.set(parent, new Map());
  if (child) {
    const children = categoryTree.get(parent)!;
    children.set(child, (children.get(child) || 0) + 1);
  }
}
const categories = [...categoryTree.entries()].map(([parent, children]) => ({
  parent,
  count: allReports.filter((r) => r.data.category[0] === parent).length,
  children: [...children.entries()],
}));

// Archives: year-month, counted
const archiveCounts = new Map<string, number>();
for (const r of allReports) {
  const ym = r.data.date.toISOString().slice(0, 7);
  archiveCounts.set(ym, (archiveCounts.get(ym) || 0) + 1);
}
const archives = [...archiveCounts.entries()].sort((a, b) => b[0].localeCompare(a[0]));
const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];

// Tags: each entry's own tags field
const tagCounts = new Map<string, number>();
for (const r of allReports) {
  for (const tag of r.data.tags || []) tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
}
const cloudTags = [...tagCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));

const dateStr = report.data.date.toISOString().slice(0, 10);
const reportsHref = `${base}3500-minds/reports/`;
---

<Layout
  title={`${report.data.title} — Crew's Voice — ai-CABIN1701`}
  description={report.data.description}
>
  <Header lang="en" />

  <a class="ev-band" href={`${base}3500-minds/`}>
    <span class="ev-band-title">A Constellation of 3,500 Minds</span>
  </a>
  <nav class="ev-roomnav">
    <a href={`${base}3500-minds/`}>Concept</a>
    <a href={`${base}3500-minds/constellation/`}>The Constellation</a>
    <a href={`${base}3500-minds/why-3500/`}>Why 3,500?</a>
    <a href={`${base}3500-minds/five-chapters/`}>Five Chapters</a>
    <a href={`${base}3500-minds/selected-minds/`}>Selected Minds</a>
    <a href={`${base}3500-minds/reports/`} class="is-active">Reports</a>
  </nav>

  <div class="ev-shell">
    <article class="ev-article">
      <p class="ev-back"><a href={`${base}3500-minds/reports/`}>← Back to Reports</a></p>

      {report.data.hero && (
        <span class="ev-thumb">
          <img src={report.data.hero} alt="" loading="eager" />
        </span>
      )}

      <h1 class="ev-title">{report.data.title}</h1>
      <p class="ev-byline">{dateStr}</p>
      <p class="ev-meta">
        <span class="ev-meta-label">Category</span>
        {report.data.category.map((c, i) => (
          <>
            {i > 0 && <span class="ev-meta-sep">›</span>}
            <a href={`${reportsHref}?cat=${encodeURIComponent(c)}`}>{c}</a>
          </>
        ))}
      </p>
      {report.data.tags && report.data.tags.length > 0 && (
        <p class="ev-meta">
          <span class="ev-meta-label">Tags</span>
          {report.data.tags.map((t, i) => (
            <>
              {i > 0 && ', '}
              <a href={`${reportsHref}?tag=${encodeURIComponent(t)}`}>{t}</a>
            </>
          ))}
        </p>
      )}

      <div class="ev-body">
        <Content />
      </div>

      <p class="ev-next"><a href={`${base}3500-minds/reports/`}>← Back to Reports</a></p>
    </article>

    <aside class="ev-aside">
      <section class="ev-side-section">
        <h3 class="ev-side-title">Recent Entries</h3>
        <ul class="ev-side-list">
          {recentEntries.map((e) => (
            <li>
              <a href={e.href}>
                <span class="ev-side-date">{e.date}</span>
                <span class="ev-side-entry-title">{e.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
      <section class="ev-side-section">
        <h3 class="ev-side-title">Categories</h3>
        <ul class="ev-cat-list">
          {categories.map((c) => (
            <>
              <li class="ev-cat-parent">
                <a href={`${base}3500-minds/reports/?cat=${encodeURIComponent(c.parent)}`}>
                  <span class="ev-cat-name">{c.parent}</span> <span class="ev-cat-count">({c.count})</span>
                </a>
              </li>
              {c.children.map(([name, count]) => (
                <li class="ev-cat-child">
                  <a href={`${base}3500-minds/reports/?cat=${encodeURIComponent(name)}`}>
                    <span class="ev-cat-name">{name}</span> <span class="ev-cat-count">({count})</span>
                  </a>
                </li>
              ))}
            </>
          ))}
        </ul>
      </section>
      <section class="ev-side-section">
        <h3 class="ev-side-title">Archives</h3>
        <ul class="ev-cat-list">
          {archives.map(([ym, count]) => {
            const [y, m] = ym.split('-');
            return (
              <li>
                <a href={`${base}3500-minds/reports/?archive=${ym}`}>
                  <span class="ev-cat-name">{monthNames[parseInt(m, 10) - 1]} {y}</span> <span class="ev-cat-count">({count})</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
      <section class="ev-side-section">
        <h3 class="ev-side-title">Tags</h3>
        <div class="ev-cloud">
          {cloudTags.map(([name, count]) => (
            <a class="ev-cloud-tag" href={`${base}3500-minds/reports/?tag=${encodeURIComponent(name)}`}>
              {name} <span class="ev-cloud-count">{count}</span>
            </a>
          ))}
        </div>
      </section>
    </aside>
  </div>

  <Footer />
</Layout>

<style>
  .ev-shell { max-width: 1020px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; display: grid; grid-template-columns: 1fr 220px; gap: 3rem; align-items: start; }
  @media (max-width: 800px) { .ev-shell { grid-template-columns: 1fr; } }
  .ev-article { max-width: 720px; }
  .ev-band { display: flex; align-items: center; justify-content: center; padding: 1.6rem 1rem; background: #04070f url('/images/3500-minds/updates.jpg') center / cover; text-decoration: none; }
  .ev-band-title { font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.2rem, 3.2vw, 1.9rem); letter-spacing: 0.02em; text-align: center; color: #fdf6e8; text-shadow: 0 0 12px rgba(253, 220, 150, 0.85), 0 0 32px rgba(253, 200, 120, 0.55), 0 0 64px rgba(253, 180, 90, 0.35); }
  .ev-roomnav { max-width: 1020px; margin: 0 auto; padding: 1.2rem 1.5rem 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; font-family: var(--font-nav); font-size: 0.88rem; }
  .ev-roomnav a { color: var(--color-tagline); text-decoration: none; }
  .ev-roomnav a:hover { color: var(--color-primary); }
  .ev-roomnav a.is-active { color: var(--color-primary); font-weight: 600; border-bottom: 1px solid currentColor; }
  .ev-back { font-family: var(--font-nav); font-size: 0.85rem; margin: 0 0 1.5rem; }
  .ev-back a, .ev-next a { color: var(--color-tagline); text-decoration: none; }
  .ev-back a:hover, .ev-next a:hover { color: var(--color-primary); }
  .ev-thumb { display: block; margin: 0 0 1.75rem; }
  .ev-thumb img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 6px; }
  .ev-title { font-family: var(--font-nav); font-weight: 500; letter-spacing: 0.01em; font-size: clamp(1.9rem, 5vw, 2.8rem); color: var(--color-primary); margin: 0 0 0.4rem; line-height: 1.25; }
  .ev-byline { font-family: var(--font-nav); font-size: 0.8rem; letter-spacing: 0.02em; color: var(--color-tagline); margin: 0 0 0.5rem; }
  .ev-meta { font-family: var(--font-nav); font-size: 0.8rem; letter-spacing: 0.02em; color: var(--color-tagline); margin: 0 0 0.3rem; }
  .ev-body { margin-top: 2rem; }
  .ev-meta-label { text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.7rem; margin-right: 0.5rem; opacity: 0.8; }
  .ev-meta-sep { margin: 0 0.35rem; }
  .ev-meta a { color: var(--color-tagline); text-decoration: none; border-bottom: 1px solid transparent; }
  .ev-meta a:hover { border-bottom-color: currentColor; }
  .ev-body :global(p) { font-family: 'EB Garamond', Georgia, serif; font-size: 1.1rem; line-height: 1.75; color: var(--color-text); margin: 0 0 1.2rem; }
  .ev-next { margin-top: 3rem; font-family: var(--font-nav); }

  .ev-body :global(.ev-log) { margin: 2rem 0; padding: 1.25rem 1.5rem; border-left: 3px solid var(--color-tagline); background: rgba(0, 0, 0, 0.03); border-radius: 0 6px 6px 0; }
  .ev-body :global(.ev-log-heading) { font-family: var(--font-nav); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-tagline); margin: 0 0 0.9rem; }
  .ev-body :global(.ev-log p) { font-family: var(--font-nav); font-size: 0.95rem; line-height: 1.7; color: var(--color-text); margin: 0 0 0.7rem; }

  .ev-body :global(.ev-figure) { margin: 1.5rem 0 1.8rem; }
  .ev-body :global(.ev-figure img) { display: block; width: 100%; border-radius: 6px; }
  .ev-body :global(.ev-figure figcaption) { font-family: var(--font-nav); font-size: 0.8rem; color: var(--color-tagline); text-align: center; margin-top: 0.5rem; }

  .ev-aside { display: flex; flex-direction: column; gap: 2rem; padding-top: 0.25rem; }
  .ev-side-section { border-top: 1px solid rgba(0, 0, 0, 0.08); padding-top: 1.1rem; }
  .ev-side-section:first-child { border-top: 0; padding-top: 0; }
  .ev-side-title { margin: 0 0 0.7rem; font-family: var(--font-nav); font-weight: 500; font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-tagline); }
  .ev-side-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  .ev-side-list a { display: flex; flex-direction: column; gap: 0.15rem; font-family: var(--font-nav); font-size: 0.9rem; line-height: 1.4; color: var(--color-text); text-decoration: none; }
  .ev-side-list a:hover .ev-side-entry-title { color: var(--color-primary); }
  .ev-side-date { font-size: 0.72rem; letter-spacing: 0.04em; color: var(--color-tagline); }
  .ev-side-entry-title { transition: color 0.2s ease; }

  .ev-cloud { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .ev-cloud-tag { display: inline-flex; align-items: center; gap: 0.3rem; font-family: var(--font-nav); font-size: 0.78rem; padding: 0.2rem 0.6rem; border-radius: 999px; border: 1px solid var(--color-tagline); color: var(--color-tagline); text-decoration: none; transition: color 0.2s ease, border-color 0.2s ease; }
  .ev-cloud-tag:hover { color: var(--color-primary); border-color: var(--color-primary); }
  .ev-cloud-count { font-size: 0.7rem; opacity: 0.7; }

  .ev-cat-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.5rem; font-family: var(--font-nav); font-size: 0.85rem; }
  .ev-cat-list a { display: inline-flex; align-items: baseline; gap: 0.3rem; text-decoration: none; }
  .ev-cat-name { color: var(--color-text); transition: color 0.2s ease; }
  .ev-cat-list a:hover .ev-cat-name { color: var(--color-primary); }
  .ev-cat-count { font-size: 0.72rem; color: var(--color-tagline); }
  .ev-cat-parent { font-weight: 600; }
  .ev-cat-child { padding-left: 1rem; }
</style>
