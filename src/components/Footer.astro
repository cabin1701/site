---
interface Props {
  lang?: 'en' | 'es' | 'ja';
}
const { lang = 'en' } = Astro.props;
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
const prefix = lang === 'es' ? `${base}es/` : lang === 'ja' ? `${base}ja/` : base;
const searchHref = lang === 'es'
  ? 'https://blog.cabin1701.com/es/search/'
  : lang === 'ja'
  ? 'https://blog.cabin1701.com/ja/search/'
  : 'https://blog.cabin1701.com/search/';
// ja → English site (船長の指定)
const japonesonHref = lang === 'es' ? 'https://japoneson.com/es/' : 'https://japoneson.com/en/';

const t = lang === 'es'
  ? {
      tagline: "The Age of Miracles Hadn't Passed * with AI",
      search: 'buscar',
      searchLabel: 'Buscar',
      aboutTitle: 'Más',
      seinaSite: 'Sitio de la Capitana Seina',
      crystallize: 'CRYSTALLIZE',
      supportTitle: 'Soporte & Contacto',
      contact: 'Contacto',
      privacy: 'Política de Privacidad',
      terms: 'Términos de Uso',
      socialTitle: 'Social',
    }
  : lang === 'ja'
  ? {
      tagline: "The Age of Miracles Hadn't Passed * with AI",
      search: '検索',
      searchLabel: '検索',
      aboutTitle: 'その他',
      seinaSite: 'セイナ船長のサイト',
      crystallize: 'CRYSTALLIZE',
      supportTitle: 'サポート・お問い合わせ',
      contact: 'お問い合わせ',
      privacy: 'プライバシーポリシー',
      terms: '利用規約',
      socialTitle: 'ソーシャル',
    }
  : {
      tagline: "The Age of Miracles Hadn't Passed * with AI",
      search: 'search',
      searchLabel: 'Search',
      aboutTitle: 'More',
      seinaSite: "Captain Seina's Site",
      crystallize: 'CRYSTALLIZE',
      supportTitle: 'Support & Contact',
      contact: 'Contact',
      privacy: 'Privacy Policy',
      terms: 'Terms of use',
      socialTitle: 'Social',
    };
---

<footer class="site-footer">
  <div class="footer-rule" aria-hidden="true"></div>
  <p class="footer-tagline">{t.tagline}</p>
  <div class="footer-rule" aria-hidden="true"></div>

  <div class="footer-dispatches-block">
    <ul class="footer-japoneson-links">
      <li><a href={`${base}contact/`}>{t.contact}</a></li>
      <li><a href={`${prefix}privacy/`}>{t.privacy}</a></li>
      <li><a href={`${prefix}terms/`}>{t.terms}</a></li>
    </ul>

    <a href={japonesonHref} target="_blank" rel="noopener noreferrer" class="footer-japoneson-strip">
      <img class="strip-blue" src={`${base}images/japoneson/shoko05-blue.jpg`} alt={t.seinaSite} loading="lazy" />
      <img class="strip-red" src={`${base}images/japoneson/shoko05-red.jpg`} alt="" loading="lazy" />
    </a>
  </div>

  <p class="footer-copy">Copyright © {year} ai-CABIN1701</p>
</footer>

<style>
  .site-footer {
    max-width: 1280px;
    margin: 1rem auto 0;
    padding: 0 1.5rem 3rem;
  }

  .footer-rule {
    border-top: 1px solid var(--color-primary);
    opacity: 0.4;
  }

  .footer-tagline {
    text-align: center;
    margin: 1.25rem 0;
    font-family: var(--font-label-plain);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--color-primary);
    letter-spacing: 0.04em;
  }

  .footer-dispatches-block {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-invite-search-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .footer-dispatches-invite {
    text-align: center;
    margin: 0;
  }
  .footer-dispatches-invite a {
    color: #2b4c9b;
    font-family: 'Gabriela', var(--font-nav);
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.00em;
    transition: color 0.2s ease;
  }
  .footer-dispatches-invite a:hover {
    color: #b01200;
  }

  .footer-col-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-nav);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--color-nav);
  }

  .footer-col ul {
    list-style: disc inside;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .footer-col li::marker {
    color: var(--color-primary);
  }
  .footer-col a {
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .footer-col a:hover {
    text-decoration: underline;
  }
  .footer-col li:not(:has(a)) {
    color: var(--color-text);
    font-size: 0.95rem;
  }

  /* Title-less columns line up with the ones that still have a heading */
  .footer-col > ul:first-child {
    margin-top: 2.2rem;
  }

  /* Japonéson filmstrip */
  .footer-japoneson-strip {
    position: relative;
    display: block;
    width: 100%;
    max-width: 720px;
  }
  .footer-japoneson-strip img {
    display: block;
    width: 100%;
    height: auto;
  }
  .footer-japoneson-strip .strip-red {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .footer-japoneson-strip:hover .strip-blue {
    opacity: 0;
  }
  .footer-japoneson-strip:hover .strip-red {
    opacity: 1;
  }
  .footer-japoneson-links {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1rem;
  }
  .footer-japoneson-links a {
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.85rem;
  }
  .footer-japoneson-links a:hover {
    text-decoration: underline;
  }

  .footer-search-form {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .footer-search-form input {
    border: none;
    border-bottom: 1px solid var(--color-nav);
    background: transparent;
    padding: 0.25rem 0.25rem;
    font-size: 0.95rem;
    min-width: 0;
    max-width: 140px;
  }
  .footer-search-form input:focus {
    outline: none;
    border-color: var(--color-primary);
  }
  .footer-search-form button {
    background: transparent;
    border: none;
    color: var(--color-nav);
    font-size: 1.4rem;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }
  .footer-search-form button:hover {
    color: var(--color-primary);
  }

  .footer-copy {
    margin-top: 2.5rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-text);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

</style>
